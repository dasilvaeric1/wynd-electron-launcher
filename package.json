{
  "name": "wynd-electron-launcher",
  "productName": "electron-launcher",
  "version": "2.6.10",
  "main": "src/main/index.js",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postversion": "git push origin --follow-tags",
    "dev:container": "cross-env RENDERER=container vite",
    "dev:loader": "cross-env RENDERER=loader vite",
    "start:main:prod": "cross-env NODE_ENV=production electron .",
    "start:main:raw:w": "cross-env NODE_ENV=development electron .",
    "logs": "pm2 logs --lines 0",
    "status": "pm2 status",
    "dist": "cross-env RENDERER=container vite build && cross-env RENDERER=loader vite build",
    "stamp": "node scripts/stamp_build.js",
    "build": "node scripts/stamp_build.js && electron-builder --publish never",
    "build:win": "node scripts/stamp_build.js && electron-builder --win --publish never",
    "build:linux": "node scripts/stamp_build.js && rm -rf dist/__appImage-x64 && mkdir -p dist/__appImage-x64 && electron-builder --linux --publish never",
    "build:mac": "node scripts/stamp_build.js && electron-builder --mac --publish never",
    "lint": "eslint",
    "test": "jest __tests__"
  },
  "author": "patrice petit",
  "license": "MIT",
  "description": "Wynd electron desktop app",
  "build": {
    "appId": "eu.wynd.electron-launcher",
    "productName": "electron-launcher",
    "extraResources": [
      "./assets/**"
    ],
    "linux": {
      "icon": "assets/icons/png/256x256.png",
      "target": [
        "AppImage"
      ],
      "artifactName": "${productName}-${version}.${ext}",
      "category": "Office"
    },
    "mac": {
      "icon": "assets/icons/mac/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.business"
    },
    "win": {
      "icon": "assets/icons/win/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}",
      "unpackDirName": "electron-launcher-portable",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "perMachine": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Wynd-Lab",
        "repo": "wynd-electron-launcher",
        "releaseType": "draft"
      }
    ],
    "files": [
      "assets",
      "src/helpers",
      "src/main",
      "src/loader/dist",
      "src/loader/assets",
      "src/container/dist",
      "src/container/assets",
      "src/local/"
    ]
  },
  "pm2": {
    "process": [
      {
        "name": "electron launcher main"
      },
      {
        "name": "electron launcher renderer"
      }
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "collectCoverageFrom": [
      "<rootDir>/src/***/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/assets/",
      "/build/",
      "/configs/",
      "/dist/",
      "/dll/",
      "/draft/",
      "/scripts/",
      "/test/"
    ],
    "coverageReporters": [
      "json"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "semi": false
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.wynd.eu/people/innovation/wynd-electron-launcher.git"
  },
  "devDependencies": {
    "@types/jest": "26.0.23",
    "@types/luxon": "2.0.4",
    "@types/node": "^20.11.0",
    "@types/numeral": "2.0.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.0.8",
    "@types/socket.io-client": "1.4.36",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "ajv": "8.11.0",
    "chalk": "4.1.1",
    "classnames": "2.3.1",
    "cross-env": "7.0.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "eslint-plugin-react": "^7.34.0",
    "husky": "6.0.0",
    "jest": "27.0.4",
    "less": "^4.2.0",
    "pm2": "5.3.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "4.8.3",
    "@fastify/http-proxy": "8.2.3",
    "@fastify/static": "6.6.0",
    "@nut-tree-fork/nut-js": "^4.2.0",
    "@styled-icons/entypo": "10.46.0",
    "@styled-icons/remix-line": "^10.46.0",
    "antd": "4.24.0",
    "axios": "0.21.4",
    "electron-extension-installer": "1.2.0",
    "electron-updater": "^6.8.9",
    "events": "3.3.0",
    "fastify": "^4.29.1",
    "human-signals": "2.1.0",
    "ini": "1.3.8",
    "jszip": "^3.10.1",
    "luxon": "2.0.2",
    "merge-stream": "2.0.0",
    "mimic-fn": "2.1.0",
    "numeral": "2.0.6",
    "onetime": "5.1.2",
    "path-is-absolute": "1.0.1",
    "rc-menu": "9.6.4",
    "rc-table": "7.26.0",
    "react": "18.2.0",
    "react-antd-cssvars": "0.7.3",
    "react-dom": "18.2.0",
    "react-redux": "8.0.4",
    "redux": "^4.2.0",
    "redux-devtools-extension": "2.13.9",
    "redux-thunk": "2.3.0",
    "socket.io-client": "2.4",
    "sprintf-js": "1.1.3",
    "strip-final-newline": "2.0.0",
    "styled-components": "5.3.5",
    "undici-types": "6.21.0",
    "winston": "3.7.2",
    "winston-daily-rotate-file": "4.7.1",
    "ws": "^8.18.0",
    "yargs": "17.0.0-candidate.13"
  },
  "pnpm": {
    "overrides": {
      "string-width": "4.2.3",
      "wrap-ansi": "7.0.0",
      "process-warning": "5.0.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "@nut-tree-fork/nut-js"
    ]
  }
}
