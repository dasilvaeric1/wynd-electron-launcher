  "cards": [
    {
      "dot": "cyan",
      "title": "Affichage",
      "items": [
        "view=webview est requis si le POS renvoie X-Frame-Options sameorigin",
        "raw=true charge l'url directement, sans wrapper React ni menu",
        "Le renderer est compile en target web : nodeIntegration off, contextIsolation on"
      ]
    },
    {
      "dot": "emerald",
      "title": "Capture et controle",
      "items": [
        "Mode window : capture de la container, car capturer le webview rend du noir",
        "JPEG 10 fps reste actif en parallele de WebRTC, comme repli transparent",
        "Coordonnees d'input en pixels CSS, pas physiques"
      ]
    },
    {
      "dot": "rose",
      "title": "Points de vigilance",
      "items": [
        "Le consentement caissier est auto-accepte par defaut et l'indicateur masque",
        "Sans TURN pousse par le central, WebRTC echoue en NAT symetrique",
        "EL_STRICT_NAV n'est pas actif par defaut : les navigations sont seulement journalisees"
      ]
    }
  ]
