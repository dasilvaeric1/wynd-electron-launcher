# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
.eslintcache

# Dependency directory
# https://www.npmjs.org/doc/misc/npm-faq.html#should-i-check-my-node_modules-folder-into-git
node_modules

# OSX
.DS_Store

# App packaged
dist
dll
.npmrc
token
src/local/*
# La page du consent screen-sessions est versionnée — elle est packagée dans
# le zip electron-builder via "files: [src/local/]"
!src/local/screen_consent.html
!src/local/screen_consent.js
# Sa feuille de style, extraite du <style> en ligne pour retirer
# 'unsafe-inline' du CSP : sans cette exception, la page serait livree
# sans aucun style.
!src/local/screen_consent.css
# Idem pour l'ecran d'attente client : sans cette exception, la CI livrerait
# un launcher dont la fenetre client pointe sur un fichier absent.
!src/local/customer_idle.html
config.ini
app-update.yml
test/*
# build stamp généré par scripts/stamp_build.js
src/main/build_info.json
# fichiers buildés injectés dans le scaffold (ne pas committer le binaire)
deploy/scaffold/Electron-Launcher/portable/*.exe
deploy/out/

# Repertoire de travail du scanner SonarQube, jamais versionne.
.scannerwork/
