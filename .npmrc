# node_modules à plat (comme yarn/npm) → compat electron-builder.
node-linker=hoisted

# Hoist TOUT à la racine : electron-builder n'inclut sinon pas les sous-deps des
# packages partagés dev/prod (ex. glob est dev ET prod via @fastify/static → sa
# sous-dep path-is-absolute était classée "dev" et exclue du bundle → "Cannot
# find module" au runtime). Les conflits de versions (process-warning, string-width,
# wrap-ansi) sont neutralisés par pnpm.overrides (versions uniques), donc le hoist
# ne peut plus placer une mauvaise version à la racine.
shamefully-hoist=true

# Build scripts autorisés dans package.json (pnpm.onlyBuiltDependencies) ; pas d'invite en CI.
auto-install-peers=true
