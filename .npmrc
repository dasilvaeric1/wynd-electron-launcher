# node_modules à plat (comme yarn/npm) → compat maximale avec electron-builder
# (qui suit les symlinks pnpm imparfaitement pour le packaging + deps natives).
node-linker=hoisted

# PAS de shamefully-hoist : il force UNE seule version par package à la racine
# et casse les deps qui ont plusieurs versions (ex. fastify veut
# process-warning@2 mais pino/light-my-request veulent v3 → la v3 hoistée
# écrasait la résolution de fastify → "require(...) is not a function").
# Le tracing electron-builder de string-width est réglé par pnpm.overrides
# (version unique), pas par le hoist.

# Les build scripts autorisés sont listés dans package.json (pnpm.onlyBuiltDependencies) ;
# on ne veut pas l'invite interactive en CI.
auto-install-peers=true
