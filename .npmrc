# node_modules à plat (comme yarn/npm) → compat maximale avec electron-builder
# (qui suit les symlinks pnpm imparfaitement pour le packaging + deps natives).
node-linker=hoisted

# Les build scripts autorisés sont listés dans package.json (pnpm.onlyBuiltDependencies) ;
# on ne veut pas l'invite interactive en CI.
auto-install-peers=true
