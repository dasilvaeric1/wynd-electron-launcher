# node_modules à plat (comme yarn/npm) → compat maximale avec electron-builder
# (qui suit les symlinks pnpm imparfaitement pour le packaging + deps natives).
node-linker=hoisted

# Hoist TOUT à la racine de node_modules (y compris deps transitives type
# string-width/wrap-ansi de yargs) → electron-builder retrouve toutes les deps
# de prod du main. Sans ça : "cannot find path for dependency" → modules
# manquants à l'exécution.
shamefully-hoist=true

# Les build scripts autorisés sont listés dans package.json (pnpm.onlyBuiltDependencies) ;
# on ne veut pas l'invite interactive en CI.
auto-install-peers=true
